# Export these using your hosting platform or shell; .env is not loaded by the app.
# Default without APP_MODE is a synthetic-only public demo.
APP_MODE=production
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_BROWSER_SERVER_ADDRESS=procurement.example.com
STREAMLIT_BROWSER_SERVER_PORT=443
# Configure OIDC in .streamlit/secrets.toml (see secrets.example.toml).
# Do not place passwords, tokens or customer data in this template.
