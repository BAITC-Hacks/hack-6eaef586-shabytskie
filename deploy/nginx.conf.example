# Render real host/certificate paths before installing. Never expose port 8501.
# This fragment belongs in nginx's http context. TLS termination is required.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
map $http_origin $origin_allowed {
    default 0;
    '' 1;
    'https://procurement.example.com' 1;
}
limit_req_zone $binary_remote_addr zone=app_requests:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=app_connections:10m;
log_format procurement_safe '$time_iso8601 status=$status method=$request_method bytes=$body_bytes_sent';

server {
    listen 443 ssl;
    server_name procurement.example.com;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    # Do not log URL arguments, media tokens, session paths, cookies or identities.
    access_log /var/log/nginx/procurement-access.log procurement_safe;
    error_log /var/log/nginx/procurement-error.log crit;
    client_max_body_size 21m;
    client_body_timeout 15s;
    if ($host != procurement.example.com) { return 444; }
    if ($origin_allowed = 0) { return 403; }

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header X-Frame-Options "DENY" always;
    # Streamlit uses inline styles. Script eval and inline script are not enabled.
    # Validate this policy with your pinned Streamlit build before public release.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Cache-Control "no-store" always;
    # Streamlit 1.64 does not set Secure on its OIDC cookie. Enforce it at TLS.
    # Do not force HttpOnly on the XSRF cookie: the frontend must read that token.
    proxy_cookie_flags ~ secure samesite=lax;

    # The identity-aware gateway must protect ALL paths, including Streamlit
    # upload/media endpoints. Example contract: oauth2-proxy on loopback:4180.
    location = /_edge_auth {
        internal;
        proxy_pass http://127.0.0.1:4180/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }
    location /oauth2/ {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        limit_req zone=app_requests burst=20 nodelay;
    }
    location / {
        auth_request /_edge_auth;
        error_page 401 = /oauth2/sign_in;
        limit_req zone=app_requests burst=30 nodelay;
        limit_conn app_connections 12;
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 180s;
    }
}

server {
    listen 80;
    server_name procurement.example.com;
    return 301 https://procurement.example.com$request_uri;
}
